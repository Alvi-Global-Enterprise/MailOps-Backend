APP_NAME="MailOps AI"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database (PostgreSQL)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=mailforge_ai
DB_USERNAME=postgres
DB_PASSWORD=secret
DB_SCHEMA=public
DB_SSLMODE=prefer

# Session
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Cache & Queue (Redis)
CACHE_STORE=database
QUEUE_CONNECTION=database

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_DB=2
REDIS_QUEUE_CONNECTION=default

# Sanctum State
SANCTUM_STATEFUL_DOMAINS=localhost:8000

# Broadcast & Filesystem
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# MailForge AI Providers
MAIL_FORGE_AI_PROVIDER=openai # openai | gemini | mock
AI_PROVIDER=openai
AI_MAX_TOKENS=1500
AI_TEMPERATURE=0.7

OPENAI_API_KEY=
OPENAI_ORGANIZATION=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT=30

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_TIMEOUT=30

# Contact Spreadsheet Import
CONTACT_IMPORT_MAX_SIZE_KB=10240

# Email Delivery (Laravel Mail / SMTP)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="outreach@mailforge.ai"
MAIL_FROM_NAME="${APP_NAME}"

# MailForge Application Tuning
MAILFORGE_DEFAULT_EMAIL_MODE=direct
MAILFORGE_RATE_LIMIT_PER_MINUTE=120
MAILFORGE_BATCH_SIZE=100
MAILFORGE_MAX_RETRIES=3
