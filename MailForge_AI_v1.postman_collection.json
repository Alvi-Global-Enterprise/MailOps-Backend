        {
            "name": "6. Campaigns - AI Generation & Lifecycle",
            "item": [
                {
                    "name": "1. Trigger AI Generation (Idempotent)",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"tone\": \"professional\",\n    \"target_audience\": \"Founders and Engineering Leads\",\n    \"key_points\": \"Seamless automated email campaigns, 10x ROI\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/campaigns/{{campaign_id}}/generate",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "campaigns",
                                "{{campaign_id}}",
                                "generate"
                            ]
                        },
                        "description": "Enqueues background AI copywriting (`GenerateCampaignEmailJob`). Idempotent (202 Accepted, 409 if already generating). NEVER sends email."
                    }
                },
                {
                    "name": "2. Approve Campaign (Human Gate)",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            }
                        ],
                        "url": {
